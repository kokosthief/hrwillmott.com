  <body>
    <div class="frame">
      <header>
        <div class="logo">HRWILLMOTT</div>
        <div class="nav-note">Amsterdam · private contact form</div>
      </header>

      <main>
        <section aria-labelledby="hero-title">
          <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Independent operator</p>
          <h1 id="hero-title">Practical work, useful systems, no public phone number.</h1>
          <p class="intro">
            Henry Willmott — rope access technician, boat-dweller, and builder of small practical tools. Based in Amsterdam, working across physical jobs, operations, and odd technical problems.
          </p>
          <div class="tags" aria-label="Work areas">
            <span class="tag">Rope access</span>
            <span class="tag">Small business systems</span>
            <span class="tag">Boats & practical projects</span>
            <span class="tag">Automation</span>
          </div>
        </section>

        <section class="card" aria-labelledby="contact-title">
          <h2 id="contact-title">Get in touch</h2>
          <p>Use the form. It keeps my direct email and number off the public internet.</p>
          <form id="contact-form" method="post" action="/api/contact">
            <label>
              Name
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              Email
              <input name="email" type="email" autocomplete="email" required />
            </label>
            <label>
              What is this about?
              <input name="subject" placeholder="Rope access, project, admin, odd request…" />
            </label>
            <label>
              Message
              <textarea name="message" required></textarea>
            </label>
            <label class="website-field" aria-hidden="true">
              Website
              <input name="website" tabindex="-1" autocomplete="off" />
            </label>
            <button type="submit">Send message</button>
            <p class="status" id="form-status" role="status" aria-live="polite"></p>
          </form>
        </section>
      </main>

      <footer>
        <span>KvK 87558467</span>
        <span>No email, phone, or WhatsApp links exposed here.</span>
      </footer>
    </div>

    <script>
      const form = document.getElementById('contact-form');
      const status = document.getElementById('form-status');
      const button = form?.querySelector('button[type="submit"]');

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = 'Sending…';
        status.className = 'status';
        button.disabled = true;

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || !data.ok) throw new Error(data.error || 'Message could not be sent.');
          form.reset();
          status.textContent = 'Sent. I’ll reply when I’ve seen it.';
          status.className = 'status success';
        } catch (error) {
          status.textContent = error.message || 'Could not send. Try again later.';
          status.className = 'status error';
        } finally {
          button.disabled = false;
        }
      });
    </script>
  </body>
