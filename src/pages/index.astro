<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>HRWILLMOTT</title>
    <meta
      name="description"
      content="HRWILLMOTT — the official internet cupboard for Henry Willmott's Dutch company paperwork, contact, and occasional useful things."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#181512" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap");

      :root {
        --bg: #f7f4ed;
        --fg: #181512;
        --muted: #6d6257;
        --line: rgba(24, 21, 18, 0.12);
        --card: rgba(255, 255, 255, 0.68);
        --shadow: rgba(20, 16, 12, 0.08) 0 18px 60px;
        --focus: #7c3aed;
        --success: #0f7b45;
        --error: #b42318;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background:
          radial-gradient(circle at 15% 15%, rgba(255, 255, 255, 0.9), transparent 26rem),
          radial-gradient(circle at 80% 5%, rgba(124, 58, 237, 0.12), transparent 22rem),
          var(--bg);
        color: var(--fg);
        font-family: Geist, Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      body {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: clamp(1rem, 3vw, 2.5rem);
      }

      .page {
        width: min(100%, 760px);
        display: grid;
        gap: clamp(1.4rem, 4vw, 2.4rem);
      }

      header,
      footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        color: var(--muted);
        font-family: "Geist Mono", ui-monospace, monospace;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .mark {
        color: var(--fg);
        font-weight: 600;
      }

      main {
        display: grid;
        gap: 1rem;
      }

      .hero,
      .contact {
        border: 1px solid var(--line);
        border-radius: 24px;
        background: var(--card);
        box-shadow: var(--shadow);
        backdrop-filter: blur(18px);
      }

      .hero {
        padding: clamp(1.5rem, 5vw, 3.2rem);
      }

      .eyebrow {
        margin: 0 0 1rem;
        color: var(--muted);
        font-family: "Geist Mono", ui-monospace, monospace;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      h1 {
        max-width: 11ch;
        margin: 0;
        font-size: clamp(3.5rem, 13vw, 8.5rem);
        line-height: 0.82;
        letter-spacing: -0.08em;
      }

      .joke {
        max-width: 36rem;
        margin: clamp(1.4rem, 3vw, 2rem) 0 0;
        color: var(--muted);
        font-size: clamp(1.08rem, 2vw, 1.35rem);
        line-height: 1.55;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
        margin-top: 1.4rem;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.7rem;
        padding: 0.75rem 1rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: #fff;
        color: var(--fg);
        text-decoration: none;
        font-weight: 500;
      }

      .button:hover {
        transform: translateY(-1px);
      }

      .contact {
        padding: clamp(1rem, 3vw, 1.4rem);
      }

      .contact summary {
        cursor: pointer;
        color: var(--fg);
        font-weight: 600;
      }

      .contact p {
        margin: 0.75rem 0 1rem;
        color: var(--muted);
      }

      form {
        display: grid;
        gap: 0.8rem;
      }

      label {
        display: grid;
        gap: 0.35rem;
        color: var(--muted);
        font-size: 0.86rem;
        font-weight: 500;
      }

      input,
      textarea {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.82);
        color: var(--fg);
        font: inherit;
        padding: 0.78rem 0.85rem;
        outline: none;
      }

      textarea {
        min-height: 8rem;
        resize: vertical;
      }

      input:focus,
      textarea:focus,
      button:focus-visible,
      a:focus-visible,
      summary:focus-visible {
        outline: 2px solid var(--focus);
        outline-offset: 2px;
      }

      button {
        width: fit-content;
        border: 0;
        border-radius: 999px;
        background: var(--fg);
        color: #fff;
        cursor: pointer;
        font: inherit;
        font-weight: 600;
        padding: 0.82rem 1rem;
      }

      button:disabled {
        cursor: wait;
        opacity: 0.62;
      }

      .website-field {
        position: absolute;
        left: -9999px;
      }

      .status {
        min-height: 1.2rem;
        margin: 0;
        color: var(--muted);
      }

      .status.success {
        color: var(--success);
      }

      .status.error {
        color: var(--error);
      }

      @media (max-width: 620px) {
        header,
        footer {
          align-items: flex-start;
          flex-direction: column;
        }

        h1 {
          font-size: clamp(3.2rem, 22vw, 6rem);
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header>
        <span class="mark">HRWILLMOTT</span>
        <span>Dutch company-shaped object</span>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <p class="eyebrow">Official-ish internet cupboard</p>
          <h1 id="hero-title">Not a startup.</h1>
          <p class="joke">
            HRWILLMOTT is mostly here so accountants, clients, forms, robots, and mildly suspicious institutions can agree that Henry Willmott exists.
          </p>
          <p class="joke">
            Currently building things, climbing things, moving things around, and resisting the urge to turn every domain name into a business model.
          </p>
          <div class="actions" aria-label="Useful links">
            <a class="button" href="https://www.linkedin.com/in/henrywillmott/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a class="button" href="#contact">Contact</a>
          </div>
        </section>

        <details class="contact" id="contact">
          <summary>Send a message</summary>
          <p>Useful messages, admin things, and real-world reasons to connect.</p>
          <form id="contact-form" method="post" action="/api/contact">
            <label>
              Name
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              Email
              <input name="email" type="email" autocomplete="email" required />
            </label>
            <label>
              What is this about?
              <input name="subject" placeholder="Admin, project, rope access, odd request…" />
            </label>
            <label>
              Message
              <textarea name="message" required></textarea>
            </label>
            <label class="website-field" aria-hidden="true">
              Website
              <input name="website" tabindex="-1" autocomplete="off" />
            </label>
            <button type="submit">Send</button>
            <p class="status" id="form-status" role="status" aria-live="polite"></p>
          </form>
        </details>
      </main>

      <footer>
        <span>KvK 87558467</span>
        <span>Amsterdam, for now</span>
      </footer>
    </div>

    <script>
      const form = document.getElementById('contact-form');
      const status = document.getElementById('form-status');
      const button = form?.querySelector('button[type="submit"]');

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = 'Sending…';
        status.className = 'status';
        button.disabled = true;

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || !data.ok) throw new Error(data.error || 'Message could not be sent.');
          form.reset();
          status.textContent = 'Sent. I’ll reply when I’ve seen it.';
          status.className = 'status success';
        } catch (error) {
          status.textContent = error.message || 'Could not send. Try again later.';
          status.className = 'status error';
        } finally {
          button.disabled = false;
        }
      });
    </script>
  </body>
</html>
