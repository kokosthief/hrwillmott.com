    <script>
      const companyShape = document.querySelector('[data-company-shape]');
      const legalStamp = document.getElementById('legal-stamp');
      const contactDetails = document.getElementById('contact');
      const openContact = document.querySelector('[data-open-contact]');
      const form = document.getElementById('contact-form');
      const status = document.getElementById('form-status');
      const button = form?.querySelector('button[type="submit"]');
      const subjectInput = form?.querySelector('input[name="subject"]');
      const subjectChips = document.querySelectorAll('[data-subject]');
      const copyButton = document.querySelector('[data-copy-details]');
      const copyStatus = document.getElementById('copy-status');

      companyShape?.addEventListener('click', () => {
        const revealing = legalStamp.hidden;
        legalStamp.hidden = !revealing;
        companyShape.setAttribute('aria-expanded', String(revealing));
      });

      openContact?.addEventListener('click', () => {
        contactDetails.open = true;
        contactDetails.scrollIntoView({ behavior: 'smooth', block: 'center' });
        form?.querySelector('input[name="name"]')?.focus({ preventScroll: true });
      });

      subjectChips.forEach((chip) => {
        chip.addEventListener('click', () => {
          subjectChips.forEach((item) => item.setAttribute('aria-pressed', 'false'));
          chip.setAttribute('aria-pressed', 'true');
          subjectInput.value = chip.dataset.subject || '';
          subjectInput.focus();
        });
      });

      subjectInput?.addEventListener('input', () => {
        subjectChips.forEach((chip) => {
          chip.setAttribute('aria-pressed', String(chip.dataset.subject === subjectInput.value));
        });
      });

      copyButton?.addEventListener('click', async () => {
        const details = 'HRWILLMOTT\nKvK 87558467\nVAT NL004438663B04\nAmsterdam, Netherlands';
        try {
          await navigator.clipboard.writeText(details);
          copyStatus.textContent = 'Copied. Bureaucracy briefly defeated.';
          copyStatus.className = 'status legal-note success';
        } catch {
          copyStatus.textContent = 'Copying failed. The bureaucracy fought back.';
          copyStatus.className = 'status legal-note error';
        }
      });

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = 'Sending…';
        status.className = 'status';
        button.disabled = true;

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new URLSearchParams(new FormData(form)),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || !data.ok) throw new Error('send-failed');
          form.reset();
          subjectChips.forEach((chip) => chip.setAttribute('aria-pressed', 'false'));
          status.textContent = 'Message filed somewhere alarmingly official.';
          status.className = 'status success';
        } catch {
          status.textContent = 'The bureaucracy has rejected this attempt. Please try again.';
          status.className = 'status error';
        } finally {
          button.disabled = false;
        }
      });
    </script>
